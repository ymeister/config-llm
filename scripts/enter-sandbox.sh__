#!/usr/bin/env bash
# Enter the hermetic dev sandbox and run a command inside it.
#
#   enter-sandbox                     # interactive shell inside the box
#   enter-sandbox <cmd> [args...]     # run <cmd> inside the box
#
# Builds a bubblewrap sandbox where only the project (and the Claude dir) are
# writable and everything else is read-only, then execs the given command (default
# `bash`) inside it. `nix develop` is just one caller: shell.nix's shellHook runs
# `enter-sandbox nix develop` for an interactive `nix develop`, so the second
# pass of the hook sets up the in-box environment and drops you at a prompt.
#
# The one host dependency is `nix`; everything else (bwrap included) comes from
# the dev shell.
#
# Multi-UID (so images that run as a fixed non-root UID, e.g. postgres:999,
# tempo:10001, prometheus:65534, start unmodified): instead of letting bwrap
# create its own single-UID user namespace, we create the box's userns on the
# host with `unshare --map-root-user --map-auto`, which uses the host's setuid
# newuidmap/newgidmap to map inner-0→our UID plus our whole /etc/subuid range
# (inner 1..N). That's the standard rootless-podman map, built once at the real
# level where newuidmap is privileged (you can't write a multi-line child map
# from inside a nested userns). bwrap then runs *inside* that userns (no
# --unshare-user), and podman treats it as its already-configured rootless userns
# (_CONTAINERS_USERNS_CONFIGURED), so containers execute in the box userns and
# pick up its subuid map. See the podman wrapper and the namespace section below.
set -euo pipefail

# The command to run inside the box (default: an interactive shell).
if [ "$#" -gt 0 ]; then cmd=("$@"); else cmd=(bash); fi

# Already inside the sandbox → don't nest another; just run the command.
if [ -n "${SANDBOXED:-}" ]; then
  exec "${cmd[@]}"
fi

if ! command -v bwrap >/dev/null 2>&1; then
  echo "sandbox: bwrap not found on PATH (is it in shell.nix buildInputs?)" >&2
  exit 1
fi

WORK_DIR="$(readlink -f .)"
UID_NUM="$(id -u)"

# Resolve the Claude dir to bind + the HOME to use inside the box. In every case
# the Claude dir is the ONLY slice of the native home made writable; the rest of
# $HOME is never bound (bwrap's root is an empty tmpfs), so it can't be read or
# written from inside.
#   1. $CLAUDE_DIR if set: a self-contained Claude home
#   2. $HOME/.local/share/Claude if it exists: also a self-contained Claude home
#   3. $HOME/.claude if it exists: NOT a home, just Claude's data dir:
#      HOME stays the real $HOME, which we mask with a tmpfs and re-expose only
#      .claude on top, so nothing else in the native home is reachable.
CLAUDE_BIND=""
HOME_INSIDE="$HOME"
MASK_HOME=""
if [ -n "${CLAUDE_DIR:-}" ]; then
  CLAUDE_BIND="$CLAUDE_DIR"; HOME_INSIDE="$CLAUDE_DIR"
elif [ -d "$HOME/.local/share/Claude" ]; then
  CLAUDE_BIND="$HOME/.local/share/Claude"; HOME_INSIDE="$HOME/.local/share/Claude"
elif [ -d "$HOME/.claude" ]; then
  CLAUDE_BIND="$HOME/.claude"; HOME_INSIDE="$HOME"; MASK_HOME=1
fi

# Scratch dir for sandbox-only artifacts (gitignored, per-worktree). Holds the
# podman config wrappers and podman's storage.
SANDBOX_DIR="$WORK_DIR/.sandbox"
mkdir -p "$SANDBOX_DIR/storage"

# --- Flag-injecting podman wrapper (sandbox-only, regenerated each entry) ---
# The box has no systemd/dbus (so cgroupfs + file events, not the systemd
# defaults which need a dbus socket) and, when nested, maybe no fuse (so vfs
# instead of overlay). ignore_chown_errors is a harmless safety net: the box
# userns maps the full subuid range so image-extraction chowns normally succeed,
# but if an image references a UID outside it, extraction still proceeds.
# Podman applies these settings reliably as CLI flags but NOT via containers.conf,
# so we wrap podman to inject them. Storage lives under the project (per-worktree
# isolation, per the storage requirement); runroot is in the box's own /run tmpfs.
# The wrapper is prepended to PATH inside the box (see shell.nix), so both the
# docker shim and podman-compose resolve podman to it.
mkdir -p "$SANDBOX_DIR/bin" "$SANDBOX_DIR/storage"
REAL_PODMAN="$(command -v podman)"
REAL_PODMAN_COMPOSE="$(command -v podman-compose)"
# Where the store lives and which driver reads it, named once. The podman
# wrapper passes these as flags; storage.conf below states the same three values
# for a podman that PATH does not resolve to the wrapper. Both come from here, so
# the two cannot describe different stores.
STORAGE_ROOT="$SANDBOX_DIR/storage"
STORAGE_RUNROOT="/run/user/$UID_NUM/containers"
if [ -e /dev/fuse ]; then STORAGE_DRIVER=overlay; else STORAGE_DRIVER=vfs; fi
cat > "$SANDBOX_DIR/bin/podman" <<EOF
#!/usr/bin/env bash
# Generated by enter-sandbox.sh. Injects the sandbox's podman settings.
# Global flags: cgroupfs + file events (no systemd/dbus), the storage driver +
# ignore_chown_errors (safety net), and the per-worktree root / box runroot.
g=(--cgroup-manager=cgroupfs --events-backend=file \\
   --storage-driver=$STORAGE_DRIVER \\
   --storage-opt=$STORAGE_DRIVER.ignore_chown_errors=true \\
   --root="$STORAGE_ROOT" --runroot="$STORAGE_RUNROOT")
# There is no writable /sys/fs/cgroup in the box, so containers must run without
# a cgroup (--cgroups=disabled). No --userns flag: podman adopts the box's own
# user namespace as its rootless userns (see the header + _CONTAINERS_USERNS_
# CONFIGURED), so by default containers run in it. A fixed image UID (postgres
# 999, tempo 10001, prometheus 65534, …) is just a process UID within that
# namespace and resolves through its subuid map, so the container starts.
case "\${1:-}" in
  run|create)
    sub="\$1"; shift
    exec "$REAL_PODMAN" "\${g[@]}" "\$sub" --cgroups=disabled "\$@" ;;
  *)
    exec "$REAL_PODMAN" "\${g[@]}" "\$@" ;;
esac
EOF
chmod +x "$SANDBOX_DIR/bin/podman"
# The same store as configuration, for a podman the wrapper never sees. The flags
# above apply only when PATH resolves podman to the wrapper, so a caller that
# invokes podman by absolute path keeps the default store under $HOME and then
# reports every container running here as missing, because it reads a different
# store than the one they live in. Storage settings do apply from a file, unlike
# the cgroup and events settings above, and CONTAINERS_STORAGE_CONF points every
# podman in the box at this one.
cat > "$SANDBOX_DIR/storage.conf" <<EOF
[storage]
driver = "$STORAGE_DRIVER"
graphroot = "$STORAGE_ROOT"
runroot = "$STORAGE_RUNROOT"

[storage.options.$STORAGE_DRIVER]
ignore_chown_errors = "true"
EOF
# Self-contained `docker` shim for the box: `docker compose` → podman-compose
# (which resolves `podman` via PATH to the wrapper above), everything else →
# the wrapper directly. This shadows shell.nix's dockerShim inside the box, so
# the box doesn't depend on that shim's form.
cat > "$SANDBOX_DIR/bin/docker" <<EOF
#!/usr/bin/env bash
# Generated by enter-sandbox.sh.
if [ "\$1" = compose ]; then
  shift
  exec "$REAL_PODMAN_COMPOSE" "\$@"
fi
exec "$SANDBOX_DIR/bin/podman" "\$@"
EOF
chmod +x "$SANDBOX_DIR/bin/docker"
# Box entrypoint: the box has no systemd to drive podman's healthcheck timers,
# so start a runner that does it: every few seconds, `podman healthcheck run`
# each running container that has a healthcheck and isn't healthy yet, then exec
# the real command. This makes `depends_on: service_healthy` resolve exactly as
# it would under systemd on a normal machine, without touching the compose
# flow. One runner per box (pidfile guard); it dies with the sandbox.
cat > "$SANDBOX_DIR/bin/box-init" <<'EOF'
#!/usr/bin/env bash
_wrap="$(dirname "$(readlink -f "$0")")/podman"
# The wrapper flags and storage.conf must name one store. They are generated from
# the same three values, so a mismatch here means one of them was edited to hold a
# literal. Warn rather than block: a podman that reads the wrong store still runs,
# it just reports every container running here as missing.
_want_root="$(sed -n 's/^graphroot = "\(.*\)"$/\1/p' "$CONTAINERS_STORAGE_CONF" 2>/dev/null)"
_seen_root="$("$_wrap" info --format '{{.Store.GraphRoot}}' 2>/dev/null)"
if [ -n "$_want_root" ] && [ "$_seen_root" != "$_want_root" ]; then
  echo "sandbox: WARNING: storage root mismatch" >&2
  echo "sandbox: WARNING: podman reads    $_seen_root" >&2
  echo "sandbox: WARNING: storage.conf says $_want_root" >&2
fi
if [ ! -e "$XDG_RUNTIME_DIR/healthrun.pid" ]; then
  ( echo "$BASHPID" > "$XDG_RUNTIME_DIR/healthrun.pid"
    while :; do
      for _hc in $("$_wrap" ps -q 2>/dev/null); do
        # Only nudge containers that have a healthcheck and aren't healthy yet.
        _st="$("$_wrap" inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$_hc" 2>/dev/null)"
        case "$_st" in
          "" | healthy) ;;
          *) "$_wrap" healthcheck run "$_hc" >/dev/null 2>&1 || true ;;
        esac
      done
      sleep 3
    done ) >/dev/null 2>&1 &
fi
exec "$@"
EOF
chmod +x "$SANDBOX_DIR/bin/box-init"

args=()

# --- Namespace isolation ---
# NOT --unshare-all: that includes --unshare-user, which would create bwrap's own
# single-UID user namespace and discard the subuid-mapped one we build below with
# `unshare`. Unshare everything else except the network (kept shared so published
# container ports are reachable from the host, as on a normal machine). bwrap runs
# as root inside the box userns, so it has the caps to set these up + mount.
args+=(--unshare-ipc --unshare-pid --unshare-uts --unshare-cgroup --die-with-parent)

# --- System directories (read-only) ---
for dir in /usr /etc; do
  [ -d "$dir" ] && args+=(--ro-bind "$dir" "$dir")
done
# /bin /sbin /lib /lib64 are real dirs or symlinks into /usr on different distros.
for dir in /bin /sbin /lib /lib64; do
  if [ -L "$dir" ]; then
    args+=(--symlink "$(readlink "$dir")" "$dir")
  elif [ -d "$dir" ]; then
    args+=(--ro-bind "$dir" "$dir")
  fi
done

# podman's rootless pause process (`catatonit -P`) is searched for at the
# hardcoded paths /usr/bin/catatonit and /usr/libexec/podman/catatonit, NOT via
# helper_binaries_dir. /usr is read-only, so overlay /usr/bin (keeping its real
# contents) and drop catatonit in where podman looks. SANDBOX_CATATONIT is provided by
# shell.nix (a nix store path), so there's no store scanning here.
if [ -n "${SANDBOX_CATATONIT:-}" ] && [ -e "$SANDBOX_CATATONIT" ]; then
  args+=(--overlay-src /usr/bin --tmp-overlay /usr/bin --ro-bind "$SANDBOX_CATATONIT" /usr/bin/catatonit)
fi

# --- Nix store + NixOS system profile (read-only) ---
[ -d /nix ] && args+=(--ro-bind /nix /nix)
[ -d /run/current-system ] && args+=(--ro-bind /run/current-system /run/current-system)

# --- Virtual filesystems ---
# Bind the host's real /dev rather than bwrap's synthetic `--dev /dev`. buildah
# RUN steps recursively bind /dev and remount it read-only; the kernel denies
# that remount when /dev contains locked read-write submounts, which is exactly
# what a synthetic /dev is (each device node is a separate bind mount). A real
# devtmpfs has its nodes as files, not submounts, so the remount succeeds, the
# same reason builds work on a normal machine. Access is still bounded by the
# user namespace (root inside the box is not real root, so it can't open nodes a
# normal non-root user couldn't). This also supplies /dev/fuse (overlay) and
# /dev/net/tun (pasta).
# Each sandbox still gets its own /run tmpfs, so podman's runroot stays per-instance.
args+=(--proc /proc --dev-bind /dev /dev --tmpfs /tmp --tmpfs /run)

# XDG runtime dir must exist for podman (its absence makes podman error out).
args+=(--dir "/run/user/$UID_NUM")

# --- Podman enablers ---
# /etc/subuid+/etc/subgid are NOT masked (they come through the /etc ro-bind):
# the box userns is built from them on the host (see the namespace section), and
# podman treats the box userns as its already-configured rootless userns.
# /sys improves cgroup/host detection (and avoids a `podman info` crash).
[ -d /sys ] && args+=(--ro-bind /sys /sys)

# --- Writable mounts: the project and the Claude dir (only) ---
# Mask the native home first when HOME is the real home, so only .claude leaks.
[ -n "$MASK_HOME" ] && args+=(--tmpfs "$HOME")
[ -n "$CLAUDE_BIND" ] && [ -d "$CLAUDE_BIND" ] && args+=(--bind "$CLAUDE_BIND" "$CLAUDE_BIND")
args+=(--bind "$WORK_DIR" "$WORK_DIR")
args+=(--chdir "$WORK_DIR")

# podman looks for policy.json (signature trust) under $HOME/.config/containers,
# and registries.conf (docker.io short-name resolution) resolves there too, since
# XDG_CONFIG_HOME defaults to $HOME/.config. Bind the repo's config dir there.
# (/etc/containers can't be used: it's absent and /etc is read-only.) Bound after
# the home mount so the mountpoint lands inside it.
[ -d "$WORK_DIR/.config/containers" ] \
  && args+=(--ro-bind "$WORK_DIR/.config/containers" "$HOME_INSIDE/.config/containers")

# --- Git worktree support ---
# In a worktree, $WORK_DIR/.git is a FILE ("gitdir: <path>") pointing at the real
# gitdir under the main repo (outside $WORK_DIR). Bind that gitdir plus the shared
# common dir (objects/refs/config), but blank out the common dir's worktrees/ so
# sibling worktrees stay inaccessible.
if [ -f "$WORK_DIR/.git" ]; then
  GIT_DIR="$(sed -n 's/^gitdir: //p' "$WORK_DIR/.git" | head -n1)"
  if [ -n "$GIT_DIR" ] && [[ "$GIT_DIR" != /* ]]; then
    GIT_DIR="$WORK_DIR/$GIT_DIR"
  fi
  GIT_DIR="$(readlink -f "$GIT_DIR" 2>/dev/null || true)"
  if [ -n "$GIT_DIR" ] && [ -d "$GIT_DIR" ]; then
    if [ -f "$GIT_DIR/commondir" ]; then
      COMMON_DIR="$(cat "$GIT_DIR/commondir")"
      [[ "$COMMON_DIR" != /* ]] && COMMON_DIR="$GIT_DIR/$COMMON_DIR"
      COMMON_DIR="$(readlink -f "$COMMON_DIR")"
    else
      COMMON_DIR="$GIT_DIR"
    fi
    args+=(--bind "$COMMON_DIR" "$COMMON_DIR")
    [ -d "$COMMON_DIR/worktrees" ] && args+=(--tmpfs "$COMMON_DIR/worktrees")
    args+=(--bind "$GIT_DIR" "$GIT_DIR")
  fi
fi

# --- Environment inside the box ---
args+=(--setenv SANDBOXED 1)
args+=(--setenv HOME "$HOME_INSIDE")
args+=(--setenv XDG_RUNTIME_DIR "/run/user/$UID_NUM")
# Reset TMPDIR: the outer nix develop points it at /run/user/.../nix-shell.XXX,
# which doesn't exist in the box's fresh /run tmpfs (podman needs a valid TMPDIR).
args+=(--setenv TMPDIR /tmp)
args+=(--setenv TERM "${TERM:-xterm-256color}")
# No /sys/fs/cgroup in the box, so podman misdetects cgroups v1. Silence the warning.
args+=(--setenv PODMAN_IGNORE_CGROUPSV1_WARNING 1)
# Every podman in the box reads the sandbox store, including one that PATH does
# not resolve to the wrapper (see the storage.conf written beside it).
args+=(--setenv CONTAINERS_STORAGE_CONF "$SANDBOX_DIR/storage.conf")
# We enter as root inside the box's subuid-mapped user namespace (`unshare
# --map-root-user`). These three tell podman it is ALREADY in its rootless
# userns: stay in rootless mode despite euid 0 (ROOTLESS_UID/GID), and skip the
# startup reexec that would otherwise try to build a fresh userns via newuidmap
# (impossible in a nested userns). This is the same handshake `podman unshare`
# uses for nested podman. Then containers run in the box userns and see its
# subuid map, the whole point of the multi-UID rework.
args+=(--setenv _CONTAINERS_USERNS_CONFIGURED done)
args+=(--setenv _CONTAINERS_ROOTLESS_UID "$UID_NUM")
args+=(--setenv _CONTAINERS_ROOTLESS_GID "$(id -g)")
# Match .envrc so a `nix develop` run inside evaluates the flake the same way.
args+=(--setenv NIXPKGS_ALLOW_INSECURE 1)
# Pass through Claude API credentials if present (for auto-mode `claude` in-box).
for var in ANTHROPIC_API_KEY CLAUDE_API_KEY; do
  [ -n "${!var:-}" ] && args+=(--setenv "$var" "${!var}")
done

# --- Build the box's user namespace (with the subuid range), then bwrap in it ---
# bwrap must NOT create the userns (--unshare-user → single UID). Instead
# `unshare` builds the standard rootless map with the host's setuid newuidmap/
# newgidmap: --map-root-user puts our UID at inner 0 (root in the box), and
# --map-auto maps our whole /etc/subuid+/etc/subgid range to the inner IDs it
# leaves free (1..N). So every UID a container runs as (0, 999, 10001, 65534, …)
# is a mapped inner ID, and bwrap + podman run inside this namespace. This is the
# same map podman would build for itself on a normal host, done here at the one
# level where newuidmap is privileged (a nested userns can't write a multi-line map).
if ! grep -Eq "^($(id -un)|$(id -u)):" /etc/subuid 2>/dev/null; then
  echo "sandbox: no /etc/subuid range for $(id -un): rootless podman needs a delegated subid range" >&2
  exit 1
fi

exec unshare --user --map-root-user --map-auto \
  -- bwrap "${args[@]}" -- "$SANDBOX_DIR/bin/box-init" "${cmd[@]}"
